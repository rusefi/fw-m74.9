
# Explicitly declare text files you want to always be normalized and converted
# to Unix line endings on checkout.
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.mk text eol=lf
*.sh text eol=lf
*.env text eol=lf
# Configuration generator inputs are hashed and must not contain CR bytes.
*.txt text eol=lf
*.ini text eol=lf
connectors/*.yaml text eol=lf
